NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Power Automate "When an HTTP request is received" Flow URL that sends outgoing email.
# Server-only (no NEXT_PUBLIC_ prefix) — it's a bearer credential and must never reach the
# browser. The app calls it through /api/send-email (src/app/api/send-email/route.ts).
# See src/lib/README-power-automate-email.md for the payload contract and Flow setup.
POWER_AUTOMATE_EMAIL_WEBHOOK_URL=

# Supabase service-role key. Server-only (no NEXT_PUBLIC_ prefix) — bypasses RLS. Used by
# /api/meetings-feed (src/app/api/meetings-feed/route.ts) to serve the Outlook/Google Calendar
# subscription feed, which authenticates via a per-user token instead of a Supabase session.
SUPABASE_SERVICE_ROLE_KEY=
